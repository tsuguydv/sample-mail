# Copy to .env and fill in values

JWT_SECRET=change-me-to-a-long-random-string

# ---- LLM provider (text + images) ----
# "gigachat" (default) or "openai"
LLM_PROVIDER=gigachat

# GigaChat (Sber) — physical person trial: scope GIGACHAT_API_PERS.
# GIGACHAT_AUTH_KEY is the "Authorization key" from the GigaChat project
# (base64 of client_id:client_secret).
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Trial accounts usually lack the Минцифры root cert; keep false for local testing.
GIGACHAT_VERIFY_SSL=false
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1

# OpenAI (fallback when LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Optional: text model (defaults are set in code if unset)
# TEXT_MODEL=gpt-4o-mini
# IMAGE_MODEL=dall-e-3

# Database
# Local dev (not on Render): uses SQLite at backend/app.db — DATABASE_URL in .env is ignored.
# Render: set DATABASE_URL on the web service (linked Postgres); RENDER=true is set automatically.
# Optional: USE_POSTGRES_LOCALLY=true to use DATABASE_URL from .env on your machine.
# LOCAL_DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/smartletters
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- Email provider (sending, contacts, campaigns, stats) ----
# "sendgrid" (default) or "unisender"
EMAIL_PROVIDER=sendgrid

# UniSender — API key from the account (Settings → Integration & API).
# UNISENDER_FROM_EMAIL must be a confirmed sender in UniSender.
# UNISENDER_LIST_ID is the list used for the unsubscribe link in single sends.
UNISENDER_API_KEY=
UNISENDER_FROM_EMAIL=
UNISENDER_FROM_NAME=
UNISENDER_LIST_ID=
# UNISENDER_BASE_URL=https://api.unisender.com/ru/api

# SendGrid (active provider — EMAIL_PROVIDER=sendgrid). Fill these in for sending,
# contacts and stats to work; otherwise calls return "SendGrid is not configured".
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_UNSUBSCRIBE_URL=
# Unsubscribe Group id (SendGrid → Suppressions → Unsubscribe Groups). Number, e.g. 12345.
SENDGRID_ASM_GROUP_ID=
# Signed Event Webhook public key (SendGrid → Settings → Mail Settings → Event Webhook).
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
# false = skip verification emails; users can sign in immediately after register
REQUIRE_EMAIL_VERIFICATION=true
# Legacy alias (used only if REQUIRE_EMAIL_VERIFICATION is unset)
# SENDGRID_ENFORCE_VERIFIED_LOGIN=true
APP_BASE_URL=http://localhost:8000
VERIFY_EMAIL_TTL_MINUTES=60

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Token economy (server-enforced)
# Set to true to remove all generation limits (no token charge, no daily quota, no reputation gating).
DISABLE_GENERATION_LIMITS=false
TOKENS_PER_TEXT=10
TOKENS_PER_IMAGE=20
TOKEN_USD_REFERENCE=0.012
FREE_PLAN_GENERATIONS_PER_DAY=1
# Optional JSON array of subscription plans (paypalPlanId falls back to PAYPAL_PLAN_ID)
# TOKEN_PLANS_JSON=[...]
REPUTATION_DEFAULT=100
REPUTATION_PENALTY_CONTENT_POLICY=10
REPUTATION_ORANGE_THRESHOLD=40
REPUTATION_RECOVERY_AMOUNT=10
REPUTATION_RECOVERY_HOURS=24
REPUTATION_BILLING_PERIOD_DAYS=30
# Admin key for refund review API (header X-Admin-Key)
ADMIN_API_KEY=

# AUTO_REGISTER_ON_LOGIN=false
